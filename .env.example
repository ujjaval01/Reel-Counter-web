# ==========================================
# ReelCounter Admin Dashboard Environment Variables Template
# Copy this to .env.local and fill in your values
# ==========================================

# 1. SERVER-SIDE (Vercel Serverless Functions)
# Used exclusively by /api/admin/* endpoints with firebase-admin.
ADMIN_UID=your_owner_firebase_auth_uid_here
FIREBASE_PROJECT_ID=reelcounter-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@reelcounter-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# 2. CLIENT-SIDE (Vite Frontend in Browser)
# Used by the Admin Google Sign-In popup on /admin.
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=reelcounter-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=reelcounter-project-id
VITE_FIREBASE_STORAGE_BUCKET=reelcounter-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456


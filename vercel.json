{
  "rewrites": [
    {
      "source": "/api/admin/:route*",
      "destination": "/api/admin?route=:route*"
    },
    {
      "source": "/api/admin",
      "destination": "/api/admin?route=overview"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

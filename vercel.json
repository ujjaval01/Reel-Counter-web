{
  "rewrites": [
    {
      "source": "/api/admin/:route",
      "destination": "/api/admin/[route]?route=:route"
    },
    {
      "source": "/api/admin",
      "destination": "/api/admin/[route]?route=overview"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
